---
import { CircleCheck, OctagonX, TriangleAlert } from "lucide-react";
import AppLayout from "../layouts/AppLayout.astro";
import { isOnshapeConfigured, onshapeOrigin } from "../lib/onshapeApi/auth";
import { summarizeOnshapeUsage } from "../lib/onshapeApi/cache";
import { onshapeBudgetStatus } from "../lib/onshapeApi/gateway";
import {
  formatCount as count,
  formatObservedAt as when,
  onshapeRemainingStatus,
} from "../lib/onshapeApi/remaining";
import { minRefreshMs } from "../lib/onshapeApi/partStudioFreshness";
import { onshapeWebhookStatus } from "../lib/onshapeApi/webhooks";
const configured = isOnshapeConfigured();
const webhooks = onshapeWebhookStatus();
const { totals, byDay } = summarizeOnshapeUsage();
const budget = onshapeBudgetStatus();
const refreshMinutes = minRefreshMs() / 60_000;
const { rows, latest, warnAt, exhausted, low } = onshapeRemainingStatus();
// Shared classes so both integration pages read the same way.
const code = "bg-muted rounded px-1 text-[0.85em] [overflow-wrap:anywhere]";
// Inside a callout the panel is already muted, so code sits on the card.
const calloutCode =
  "bg-card rounded px-1 text-[0.85em] [overflow-wrap:anywhere]";
// Labels may wrap; justify-between pins every figure to the tile bottom.
const tile = "bg-muted flex flex-col justify-between gap-2 rounded-md p-3";
const tileLabel = "text-muted-foreground text-xs font-semibold uppercase";
const tileFigure = "brand-figures text-2xl font-semibold";
const th = "font-heading py-2 font-semibold";
---

<AppLayout title="Onshape API status"
  ><main class="bg-card max-w-2xl space-y-6 rounded-lg border p-4 sm:p-6">
    <h1 class="text-2xl">Onshape API status</h1>
    {
      configured ? (
        <div class="callout callout-teal flex gap-3">
          <CircleCheck
            aria-hidden="true"
            className="text-icon-accent mt-0.5 size-5 shrink-0"
          />
          <div class="min-w-0 space-y-1">
            <p class="font-heading font-semibold">Connected</p>
            <p>The server has an Onshape API key pair configured.</p>
            <p class="text-muted-foreground text-sm">
              Onshape stack:{" "}
              <span class="brand-figures break-all">{onshapeOrigin()}</span>
            </p>
          </div>
        </div>
      ) : (
        <div class="callout callout-red flex gap-3">
          <OctagonX aria-hidden="true" className="mt-0.5 size-5 shrink-0" />
          <div class="min-w-0 space-y-1">
            <p class="font-heading font-semibold">Not configured</p>
            <p>
              Onshape API access is not configured. Ask the deployment operator
              to set the server API key pair,{" "}
              <code class={calloutCode}>ONSHAPE_ACCESS_KEY</code> and{" "}
              <code class={calloutCode}>ONSHAPE_SECRET_KEY</code>.
            </p>
          </div>
        </div>
      )
    }
    {
      exhausted.length > 0 && (
        <div role="alert" class="callout callout-red flex gap-3">
          <OctagonX aria-hidden="true" className="mt-0.5 size-5 shrink-0" />
          <div class="min-w-0 space-y-1">
            <h2 class="font-heading text-base font-semibold">
              Onshape API allocation used up
            </h2>
            <p>
              Onshape answered 402 for{" "}
              {exhausted.map((row) => row.label).join(", ")} on{" "}
              {when(exhausted[0].observedAt)}.
            </p>
          </div>
        </div>
      )
    }

    {
      budget.reached && (
        <div role="alert" class="callout callout-red flex gap-3">
          <OctagonX aria-hidden="true" className="mt-0.5 size-5 shrink-0" />
          <div class="min-w-0 space-y-1">
            <h2 class="font-heading text-base font-semibold">
              Daily Onshape budget reached
            </h2>
            <p>
              Hawk Shop has sent{" "}
              <span class="brand-figures">{count(budget.today)}</span> calls
              today (UTC), the daily limit. CAD data is served from cache, even
              if it is stale, and anything not cached is unavailable until
              tomorrow.
            </p>
          </div>
        </div>
      )
    }

    <section class="space-y-3" aria-labelledby="usage-heading">
      <h2 id="usage-heading" class="text-xl">Hawk Shop usage</h2>
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class={tile}>
          <dt class={tileLabel}>Calls sent to Onshape</dt>
          <dd class={tileFigure}>{count(totals.calls)}</dd>
        </div>
        <div class={tile}>
          <dt class={tileLabel}>Served from cache</dt>
          <dd class={tileFigure}>{count(totals.hits)}</dd>
        </div>
        <div class={tile}>
          <dt class={tileLabel}>Cache hit rate</dt>
          <dd class={tileFigure}>
            {totals.hitRate}<span class="font-sans">%</span>
          </dd>
        </div>
        <div class={tile}>
          <dt class={tileLabel}>Today (UTC)</dt>
          <dd class={tileFigure}>
            {count(budget.today)}{" "}
            <span class="text-muted-foreground font-sans text-xs font-normal">
              {
                budget.limit === null ? (
                  "no daily limit"
                ) : (
                  <>
                    of <span class="brand-figures">{count(budget.limit)}</span>
                  </>
                )
              }
            </span>
          </dd>
        </div>
      </dl>
      {
        byDay.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <caption class="sr-only">
                Recent calls by day and endpoint
              </caption>
              <thead class="text-muted-foreground border-b text-left">
                <tr>
                  <th scope="col" class={th}>
                    Day (UTC)
                  </th>
                  <th scope="col" class={th}>
                    Endpoint
                  </th>
                  <th scope="col" class={`${th} text-right`}>
                    Calls
                  </th>
                  <th scope="col" class={`${th} text-right`}>
                    Cached
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {byDay.slice(0, 7).map((row) => (
                  <tr>
                    <td class="brand-figures py-2 pr-3 whitespace-nowrap">
                      {row.day}
                    </td>
                    <td class="py-2 pr-3 break-words">{row.label}</td>
                    <td class="brand-figures py-2 pl-3 text-right">
                      {count(row.calls)}
                    </td>
                    <td class="brand-figures py-2 pl-3 text-right">
                      {count(row.hits)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <section class="space-y-3" aria-labelledby="remaining-heading">
      <h2 id="remaining-heading" class="text-xl">Onshape's reported count</h2>
      {
        latest ? (
          <>
            {latest.value === null ? (
              <p>
                Onshape has not reported a remaining count for {latest.label}.
              </p>
            ) : (
              <div class={tile}>
                <p class={tileLabel}>Onshape reports</p>{" "}
                <p class={tileFigure}>{count(latest.value)}</p>{" "}
                <p class="text-sm">calls remaining</p>
              </div>
            )}
            <p class="text-muted-foreground text-sm">
              Latest: {latest.label}, observed{" "}
              <span class="brand-figures">{when(latest.observedAt)}</span>
            </p>
            {low.length > 0 && (
              <div role="alert" class="callout flex gap-3">
                <TriangleAlert
                  aria-hidden="true"
                  className="mt-0.5 size-5 shrink-0"
                />
                <div class="min-w-0 space-y-1">
                  <h3 class="font-heading font-semibold">
                    Onshape's reported count is low
                  </h3>
                  <p>
                    The count for {low.map((row) => row.label).join(", ")} is
                    below <span class="brand-figures">{count(warnAt)}</span>.
                  </p>
                </div>
              </div>
            )}
            {rows.length > 1 && (
              <ul class="divide-y border-y text-sm">
                {rows.map((row) => (
                  <li class="grid grid-cols-[1fr_auto] gap-x-3 py-2">
                    <span class="font-semibold break-words">
                      {row.label}
                      <span class="sr-only">:</span>
                    </span>{" "}
                    <span class="brand-figures text-right">
                      {row.value === null ? "unknown" : count(row.value)}
                    </span>{" "}
                    <span class="text-muted-foreground col-span-2 text-xs">
                      <span class="sr-only">(</span>observed{" "}
                      <span class="brand-figures">{when(row.observedAt)}</span>
                      <span class="sr-only">)</span>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <p>Onshape has not reported a remaining count yet.</p>
        )
      }
      <p class="text-muted-foreground text-sm">
        This count comes from Onshape's response header and appears to be per
        endpoint. It is not the yearly allocation, which only Onshape's
        developer portal shows.
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="webhooks-heading">
      <h2 id="webhooks-heading" class="text-xl">Change webhooks</h2>
      {
        webhooks.enabled ? (
          <>
            <p>
              Registered for{" "}
              <span class="brand-figures">{count(webhooks.registered)}</span>{" "}
              {webhooks.registered === 1 ? "document" : "documents"}.
            </p>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
              <dt class="text-muted-foreground">Last event</dt>
              <dd>
                {webhooks.lastEventAt ? (
                  <span class="brand-figures">
                    {when(webhooks.lastEventAt)}
                  </span>
                ) : (
                  "never"
                )}
              </dd>
              <dt class="text-muted-foreground">
                Last repair pass<span class="sr-only">:</span>
              </dt>
              <dd>
                {webhooks.lastRepairAt ? (
                  <>
                    <span class="brand-figures">
                      {when(webhooks.lastRepairAt)}
                    </span>
                    , because{" "}
                    {webhooks.lastRepairReason === "callback-changed"
                      ? "the callback URL changed"
                      : "a document changed in Onshape without a delivery"}
                    {webhooks.lastRepairDocumentId &&
                      ` (document ${webhooks.lastRepairDocumentId})`}
                    .
                  </>
                ) : (
                  "never"
                )}
              </dd>
            </dl>
            <p class="text-muted-foreground text-sm">
              A repair pass lists the webhooks and fixes missing or misdirected
              ones. It runs only on evidence that one stopped delivering, at
              most once a day.
            </p>
            <p class="text-muted-foreground text-sm">
              After a CAD edit, a Part Studio is read from Onshape again at most
              once every{" "}
              <span class="brand-figures">{count(refreshMinutes)}</span>{" "}
              {refreshMinutes === 1 ? "minute" : "minutes"}, and only when
              someone opens it, so parts can lag Onshape by that long. Set{" "}
              <code class={code}>ONSHAPE_MIN_REFRESH_SECONDS</code> to change
              the window.
            </p>
          </>
        ) : (
          <>
            <p>
              <span class="font-semibold">Disabled.</span> Workspace reads
              refresh when their cache expires.
            </p>
            <p class="text-muted-foreground text-sm">
              Set <code class={code}>ONSHAPE_WEBHOOK_SECRET</code> and{" "}
              <code class={code}>ONSHAPE_WEBHOOK_BASE_URL</code> to enable them.
            </p>
          </>
        )
      }
    </section>

    <div class="space-y-2 border-t pt-4">
      <p class="text-muted-foreground text-sm">
        CAD access uses the server's Onshape account. Shop sign-in and
        manufacturing submitters use Hawk Suite.
      </p>
      <p class="hidden lg:block">
        <a href="/kanban" class="text-link">Return to board</a>
      </p>
    </div>
  </main></AppLayout
>
