---
import AppLayout from "~/layouts/AppLayout.astro";
import MachinePage from "~/components/islands/MachinePage";
import { getEquipmentById } from "~/server/equipmentApi/equipment";
const equipment = await getEquipmentById(Astro.params.id!);
if (!equipment) Astro.response.status = 404;
---

<AppLayout title={equipment?.name || "Equipment not found"} workspace>
  {
    equipment ? (
      <MachinePage id={equipment.id} client:load />
    ) : (
      <section class="mx-auto w-full max-w-6xl space-y-3 px-5 py-6">
        <>
          <h1 class="text-3xl">Equipment not found</h1>
          <a href="/equipment" class="text-link text-sm">
            Back to equipment
          </a>
        </>
      </section>
    )
  }
</AppLayout>
