---
import AppLayout from "../layouts/AppLayout.astro";
import { getCards } from "../server/kanbanApi/cards";
import { getEquipment } from "../server/equipmentApi/equipment";
import { WORKFLOW_COLUMN_IDS } from "../server/kanbanApi/columnTypes";
import { partHref } from "../lib/phone";
import { differenceInCalendarDays, parseISO } from "date-fns";
import {
  ChartColumn,
  ChevronRight,
  Inbox,
  List,
  MonitorPlay,
  SquareKanban,
  UserRound,
} from "lucide-react";

/**
 * The hub: where a member lands and picks what they're doing today. Each
 * destination carries one live number so the choice is informed, and the
 * parts due soonest sit underneath. Overall shop status lives on the Shop
 * tab and Metrics, not here.
 */

// The middleware only renders pages for a verified member.
const viewerId = Astro.locals.identity?.subject ?? "";
const [cardResult, equipmentResult] = await Promise.all([
  getCards(),
  getEquipment(),
]);
const cards = cardResult.cards;
const equipment = equipmentResult.equipment;

const { backlog, inProgress, review, done } = WORKFLOW_COLUMN_IDS;
const inColumn = (id: string) => cards.filter((card) => card.column_id === id);
const backlogCards = inColumn(backlog);
const active = cards.filter((card) => card.column_id !== done);
const mine = active.filter((card) => card.created_by === viewerId);
const maintenance = equipment.filter(
  (item) => item.status === "maintenance"
).length;

const dueSoon = active
  .filter((card) => card.due_date)
  .map((card) => ({
    card,
    days: differenceInCalendarDays(parseISO(card.due_date!), new Date()),
  }))
  .filter((entry) => entry.days <= 2)
  .sort((a, b) => a.days - b.days);
const overdue = dueSoon.filter((entry) => entry.days < 0).length;

const plural = (count: number, word: string) =>
  `${count} ${word}${count === 1 ? "" : "s"}`;
const dueLabel = (days: number) =>
  days < 0
    ? `${plural(-days, "day")} overdue`
    : days === 0
      ? "Due today"
      : days === 1
        ? "Due tomorrow"
        : `Due in ${days} days`;

const groups = [
  {
    title: "Make parts",
    items: [
      {
        href: "/next",
        icon: List,
        label: "Next up",
        body: "Pick your machine and work through its queue.",
        stat: `${backlogCards.length} in the backlog`,
      },
      {
        href: "/station",
        icon: MonitorPlay,
        label: "Station screen",
        body: "The shared shop screen. Claim parts by name or QR code.",
        stat: plural(equipment.length, "machine"),
      },
    ],
  },
  {
    title: "Plan and assign",
    items: [
      {
        href: "/backlog",
        icon: Inbox,
        label: "Backlog",
        body: "Send released parts to a machine.",
        stat: `${backlogCards.filter((card) => !card.machine_id).length} with no machine`,
      },
      {
        href: "/shop",
        icon: ChartColumn,
        label: "Shop",
        body: "What every machine is doing and what needs a mentor.",
        stat: maintenance
          ? `${plural(maintenance, "machine")} need${maintenance === 1 ? "s" : ""} maintenance`
          : `${inColumn(review).length} in review`,
      },
      {
        href: "/kanban",
        icon: SquareKanban,
        label: "Board",
        body: "Every part by stage, with filters and bulk moves.",
        stat: `${inColumn(inProgress).length} in progress${overdue ? ` · ${overdue} overdue` : ""}`,
        // Below the desktop breakpoint /kanban redirects to Next up.
        desktopOnly: true,
      },
    ],
  },
  {
    title: "Design",
    items: [
      {
        href: "/my-parts",
        icon: UserRound,
        label: "My parts",
        body: "Parts you released from Onshape and where they are.",
        stat: `${mine.length} active`,
      },
    ],
  },
];

const more = [
  { href: "/equipment", label: "Equipment" },
  { href: "/projects", label: "Projects" },
  { href: "/metrics", label: "Metrics" },
  { href: "/onshape", label: "Onshape API status" },
  { href: "/slack", label: "Slack settings" },
];
---

<AppLayout title="Home"
  ><main class="space-y-8">
    <header>
      <h1 class="text-3xl">Start here</h1>
      <p class="text-muted-foreground">What are you working on today?</p>
    </header>
    {
      (cardResult.error || equipmentResult.error) && (
        <p role="alert" class="border-primary bg-card border-l-4 p-4">
          Some shop data could not be loaded. Reload this page to try again.
        </p>
      )
    }
    {
      groups.map((group) => (
        <section aria-labelledby={`hub-${group.title}`} class="space-y-3">
          <h2
            id={`hub-${group.title}`}
            class="text-muted-foreground text-sm font-semibold"
          >
            {group.title}
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((item) => (
              <li class:list={[item.desktopOnly && "hidden lg:block"]}>
                <a
                  href={item.href}
                  class="bg-card hover:border-primary focus-visible:border-primary text-foreground flex h-full min-h-24 items-start gap-4 rounded-xl border p-4 no-underline"
                >
                  <item.icon
                    className="text-primary mt-0.5 size-6 shrink-0"
                    aria-hidden="true"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="block text-lg font-semibold">
                      {item.label}
                    </span>
                    <span class="text-muted-foreground block text-sm">
                      {item.body}
                    </span>
                    <span class="mt-2 block text-sm font-semibold">
                      {item.stat}
                    </span>
                  </span>
                  <ChevronRight
                    className="text-muted-foreground mt-1 size-5 shrink-0"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <section aria-labelledby="hub-due" class="space-y-3">
      <h2 id="hub-due" class="text-muted-foreground text-sm font-semibold">
        Due soon
      </h2>
      {
        dueSoon.length ? (
          <ul class="bg-card overflow-hidden rounded-xl border">
            {dueSoon.slice(0, 6).map(({ card, days }) => (
              <li class="not-last:border-b">
                <a
                  href={partHref(card.id)}
                  class="text-foreground flex min-h-11 items-center justify-between gap-3 px-3 py-2 no-underline"
                >
                  <span class="min-w-0 font-semibold break-words">
                    {card.title}
                  </span>
                  <span
                    class:list={[
                      "shrink-0 text-xs",
                      days < 0
                        ? "text-destructive font-semibold"
                        : "text-muted-foreground",
                    ]}
                  >
                    {dueLabel(days)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground text-sm">
            Nothing due in the next two days.
          </p>
        )
      }
      {
        dueSoon.length > 6 && (
          <a href="/kanban" class="hidden text-sm lg:block">
            {dueSoon.length - 6} more on the board
          </a>
        )
      }
    </section>
    <nav aria-label="More pages" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {more.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </main></AppLayout
>
