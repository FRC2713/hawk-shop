---
import "../styles/global.css";
import "../styles/station.css";
import { reportsEnabled } from "../server/reports";
import { ReportProblem } from "../components/app/report-problem";
import { suiteUrl } from "../server/suite-identity";
import PhoneTabBar from "../components/phone/PhoneTabBar.astro";
import { PHONE_TABS } from "../lib/phone";
interface Props {
  title: string;
  workspace?: boolean;
  /** Full-screen shared station display with its own navigation. */
  station?: boolean;
  /**
   * Below the desktop breakpoint: "tabs" (default) swaps the top navigation
   * for the bottom tabs; "page" is a full-screen page with its own header and
   * no tabs (the part page); "plain" keeps the desktop header (the Onshape
   * connector, which lives in a narrow Onshape panel).
   */
  phone?: "tabs" | "page" | "plain";
  /**
   * The header spans the window (the board). Every other page, workspace or
   * not, keeps its header and content in the shared max-w-6xl px-5 container.
   */
  fullBleed?: boolean;
}
const {
  title,
  workspace = false,
  phone = "tabs",
  station = false,
  fullBleed = false,
} = Astro.props;
const identity = Astro.locals.identity;
const reporting = Boolean(identity && reportsEnabled());
const name = identity?.name ?? identity?.email ?? "Suite member";
const initials = name
  .split(/[\s@._-]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("");
const links = [
  { href: "/", label: "Home" },
  { href: "/next", label: "Next up" },
  { href: "/backlog", label: "Backlog" },
  { href: "/shop", label: "Shop" },
  { href: "/kanban", label: "Board" },
  { href: "/my-parts", label: "My parts" },
  { href: "/projects", label: "Projects" },
  { href: "/equipment", label: "Equipment" },
  { href: "/metrics", label: "Metrics" },
];
// The phone account menu lists only pages the bottom tabs don't cover; the
// board has no phone layout.
const phoneTabHrefs = new Set<string>([
  "/kanban",
  ...PHONE_TABS.map((tab) => tab.href),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Manufacturing, equipment, and processes for Red Hawk Robotics."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Hawk Shop</title>
    <slot name="head" />
  </head>
  <body
    data-reports-enabled={String(reporting)}
    class:list={[
      workspace && "shop-workspace",
      !station && identity && phone === "tabs" && "phone-tabs-layout",
      phone === "page" && "phone-page-layout",
    ]}
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      !station && (
        <header class="app-header bg-card border-b">
          <div
            class:list={[
              "shop-header mx-auto flex w-full flex-wrap items-center justify-between gap-3 py-3",
              fullBleed ? "px-4" : "max-w-6xl px-5",
            ]}
          >
            <a
              href="/"
              aria-label="Hawk Shop overview"
              class="flex items-center gap-3 no-underline"
            >
              <span class="brand-mark" aria-hidden="true">
                <img src="/brand/2713-red.svg" alt="" width="83" height="24" />
              </span>
              <span>
                <>
                  <strong class="block text-sm leading-tight">Hawk Shop</strong>
                  <span class="text-muted-foreground block text-xs">
                    Manufacturing
                  </span>
                </>
              </span>
            </a>
            {identity && (
              <div class="flex items-center gap-4">
                <nav
                  aria-label="Main navigation"
                  class="app-navigation flex items-center gap-4"
                >
                  {links.map((link) => (
                    <a
                      href={link.href}
                      aria-current={
                        (
                          link.href === "/"
                            ? Astro.url.pathname === "/"
                            : Astro.url.pathname.startsWith(link.href)
                        )
                          ? "page"
                          : undefined
                      }
                      class="text-sm font-semibold"
                    >
                      {link.label}
                    </a>
                  ))}
                </nav>
                <details class="account-menu" data-account-menu>
                  <summary
                    class="account-trigger text-sm font-semibold"
                    aria-label={`Account: ${name}`}
                  >
                    <>
                      <span class="account-avatar" aria-hidden="true">
                        {initials}
                      </span>
                      <span class="account-trigger-name">{name}</span>
                    </>
                  </summary>
                  <div class="account-panel bg-popover text-popover-foreground border">
                    <p class="account-name">{name}</p>
                    {identity.email && (
                      <p class="account-email">{identity.email}</p>
                    )}
                    {phone === "tabs" && (
                      <nav aria-label="More pages" class="phone-more-pages">
                        {links
                          .filter((link) => !phoneTabHrefs.has(link.href))
                          .map((link) => (
                            <a
                              class="account-sign-out"
                              href={link.href}
                              aria-current={
                                (
                                  link.href === "/"
                                    ? Astro.url.pathname === "/"
                                    : Astro.url.pathname.startsWith(link.href)
                                )
                                  ? "page"
                                  : undefined
                              }
                            >
                              {link.label}
                            </a>
                          ))}
                      </nav>
                    )}
                    {reporting && <ReportProblem client:load />}
                    <a
                      class="account-sign-out"
                      href="/slack"
                      aria-current={
                        Astro.url.pathname === "/slack" ? "page" : undefined
                      }
                    >
                      Slack notifications
                    </a>
                    <a
                      class="account-sign-out"
                      href="/onshape"
                      aria-current={
                        Astro.url.pathname === "/onshape" ? "page" : undefined
                      }
                    >
                      Onshape API status
                    </a>
                    <a class="account-sign-out" href={suiteUrl("auth/portal")}>
                      Hawk Suite
                    </a>
                    <a class="account-sign-out" href="/auth/logout">
                      Sign out of Hawk Suite
                    </a>
                  </div>
                </details>
              </div>
            )}
          </div>
        </header>
      )
    }
    <div
      id="main-content"
      tabindex="-1"
      class:list={[
        "shop-content",
        workspace
          ? "min-h-0 flex-1"
          : "mx-auto w-full max-w-6xl px-5 pt-4 pb-6 sm:py-8",
      ]}
    >
      <slot />
    </div>
    {
      !workspace && !station && phone !== "page" && (
        <footer class="app-footer text-muted-foreground mx-auto w-full max-w-6xl px-5 py-8 text-xs">
          Red Hawk Robotics · FRC 2713
        </footer>
      )
    }
    {!station && identity && phone === "tabs" && <PhoneTabBar />}
  </body>
</html>
<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    "[data-account-menu]"
  )) {
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
