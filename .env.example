# Copy to .env. Shop access requires the Hawk Suite gateway.
# Use an isolated network: never expose the app port with proxy trust enabled.
HAWK_SUITE_TRUST_PROXY=false
HAWK_SUITE_TEAM_ID=
HAWK_SUITE_ISSUER=
# Example issuer: https://apps.redhawkrobotics.org/

# Local development without the gateway: `npm run dev` signs every loopback
# request in as a fixed "Local Developer" member. Requires proxy trust off.
# Ignored by `npm run build` / `npm run start`, which contain no such code.
# HAWK_SHOP_DEV_SIGNIN=true

HOST=127.0.0.1
PORT=3000

# --- Onshape API (optional) ------------------------------------------------------
# Needed only for CAD import and part-number writes; never used for Shop login.
# Create a key pair at https://dev-portal.onshape.com/keys. Every CAD request
# uses this account's permissions, so grant it read and write on the robot
# documents and nothing more.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Enterprise stacks: https://<company>.onshape.com
# ONSHAPE_BASE_URL=https://cad.onshape.com

# --- Deployment ----------------------------------------------------------
# Browser-facing origin, used for same-origin write checks and return URLs.
APP_URL=http://localhost:3000

# --- Storage -------------------------------------------------------------
# Everything durable lives under DATA_DIR: the SQLite file and uploaded images.
# In Docker this is the mounted volume (/data); locally it defaults to ./data.
DATA_DIR=./data

# Override individually if you need them somewhere else.
# DATABASE_PATH=./data/hawk-shop.db
# UPLOADS_DIR=./data/uploads

# Workspace default: 86400 seconds (24h) with configured webhooks, otherwise 300 (5m).
# Optional finite, positive override in seconds. Versions and microversions never expire.
# ONSHAPE_CACHE_TTL_SECONDS=300

# After a webhook reports a CAD edit, a workspace Part Studio is read from
# Onshape again at most once per this many seconds, and only when someone opens
# it. Positive integer; default 300.
# ONSHAPE_MIN_REFRESH_SECONDS=300

# Optional Onshape webhooks mark a document's workspace cache stale when it changes.
# Enabled only when both are set; otherwise /api/onshape/webhook answers 404.
# The base URL is the public origin Onshape can reach (not necessarily APP_URL);
# the gateway must route POST /api/onshape/webhook there without Suite sign-in.
# Generate the secret with: openssl rand -hex 32
ONSHAPE_WEBHOOK_SECRET=
ONSHAPE_WEBHOOK_BASE_URL=

# Optional daily ceiling on Onshape calls (UTC day, all features). Once reached,
# CAD reads are served from cache even if stale, and anything uncached answers
# 503 until tomorrow. Unset, empty, zero or non-integer means no limit.
# ONSHAPE_DAILY_CALL_LIMIT=50

# /onshape warns when Onshape's reported remaining count (x-rate-limit-remaining,
# per endpoint, not the yearly allocation) drops below this.
ONSHAPE_REMAINING_WARN_AT=1000

# Optional Slack manufacturing notifications. Installed once in the approved workspace.
SLACK_BOT_TOKEN=
# Defaults to HAWK_SUITE_TEAM_ID. Set only if the bot lives in another workspace.
SLACK_WORKSPACE_ID=
# Optional. With it, release messages get link buttons and Slack's clicks are
# verified at POST /api/slack/interactions; without it they use text links.
SLACK_SIGNING_SECRET=

# Station rosters use this team's local calendar day, starting at the cutoff.
# IANA timezone and local hour 0-23. Defaults: America/New_York, 3 AM.
# Invalid values fail roster reads/actions rather than silently changing days.
# SHOP_TIMEZONE=America/New_York
# SHOP_DAY_CUTOFF_HOUR=3

# Optional MCP OAuth, matching Hawk Eye's client connection workflow.
# Requires the trusted Suite gateway and a public HTTPS APP_URL origin.
# The gateway must expose MCP discovery, registration, token and revocation
# routes while protecting consent and connections with Suite sign-in.
# See docs/mcp.md and deploy/hawk-shop-mcp-oauth.patch. No signing secret needed.
MCP_OAUTH_ENABLED=false
