# Copy to .env. Shop access requires the Hawk Suite gateway.
# Use an isolated network: never expose the app port with proxy trust enabled.
HAWK_SUITE_TRUST_PROXY=false
HAWK_SUITE_TEAM_ID=
HAWK_SUITE_ISSUER=
# Example issuer: https://apps.redhawkrobotics.org/

HOST=127.0.0.1
PORT=3000

# --- Onshape CAD connection (optional) -------------------------------------------
# Needed only for CAD import and part-number writes; never used for Shop login.
# Create an app at https://dev-portal.onshape.com/oauthApps
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Must exactly match the redirect URL registered on the Onshape app.
ONSHAPE_REDIRECT_URI=http://localhost:3000/auth/onshape/callback
ONSHAPE_SCOPE=OAuth2Read OAuth2ReadPII OAuth2Write

# --- Deployment ----------------------------------------------------------
# Public origin the app is reached at. Used to decide whether auth cookies
# get the Secure flag.
APP_URL=http://localhost:3000

# Set true only when serving over HTTPS *and* embedding the app in Onshape's
# iframe — it switches auth cookies to SameSite=None, which browsers reject
# over plain HTTP. Leave false for a LAN deployment.
ONSHAPE_IFRAME_EMBED=false

# Override cookie Secure detection if you terminate TLS somewhere APP_URL
# doesn't reflect. Leave unset to derive it from APP_URL.
# COOKIE_SECURE=true

# --- Storage -------------------------------------------------------------
# Everything durable lives under DATA_DIR: the SQLite file and uploaded images.
# In Docker this is the mounted volume (/data); locally it defaults to ./data.
DATA_DIR=./data

# Override individually if you need them somewhere else.
# DATABASE_PATH=./data/hawk-shop.db
# UPLOADS_DIR=./data/uploads

# Editable workspace responses expire after this many seconds. Versions remain cached.
ONSHAPE_CACHE_TTL_SECONDS=300
