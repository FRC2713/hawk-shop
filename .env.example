# Copy to .env. Shop access requires the Hawk Suite gateway.
# Use an isolated network: never expose the app port with proxy trust enabled.
HAWK_SUITE_TRUST_PROXY=false
HAWK_SUITE_TEAM_ID=
HAWK_SUITE_ISSUER=
# Example issuer: https://apps.redhawkrobotics.org/

HOST=127.0.0.1
PORT=3000

# --- Onshape API (optional) ------------------------------------------------------
# Needed only for CAD import and part-number writes; never used for Shop login.
# Create a key pair at https://dev-portal.onshape.com/keys. Every CAD request
# uses this account's permissions, so grant it read and write on the robot
# documents and nothing more.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Enterprise stacks: https://<company>.onshape.com
# ONSHAPE_BASE_URL=https://cad.onshape.com

# --- Deployment ----------------------------------------------------------
# Browser-facing origin, used for same-origin write checks and return URLs.
APP_URL=http://localhost:3000

# --- Storage -------------------------------------------------------------
# Everything durable lives under DATA_DIR: the SQLite file and uploaded images.
# In Docker this is the mounted volume (/data); locally it defaults to ./data.
DATA_DIR=./data

# Override individually if you need them somewhere else.
# DATABASE_PATH=./data/hawk-shop.db
# UPLOADS_DIR=./data/uploads

# Editable workspace responses expire after this many seconds. Versions remain cached.
ONSHAPE_CACHE_TTL_SECONDS=300

# Optional Onshape webhooks clear a document's workspace cache when it changes.
# Enabled only when both are set; otherwise /api/onshape/webhook answers 404.
# The base URL is the public origin Onshape can reach (not necessarily APP_URL);
# the gateway must route POST /api/onshape/webhook there without Suite sign-in.
# Generate the secret with: openssl rand -hex 32
ONSHAPE_WEBHOOK_SECRET=
ONSHAPE_WEBHOOK_BASE_URL=

# /onshape warns when Onshape's reported remaining count (x-rate-limit-remaining,
# per endpoint, not the yearly allocation) drops below this.
ONSHAPE_REMAINING_WARN_AT=1000

# Optional Slack manufacturing notifications. Installed once in the approved workspace.
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
