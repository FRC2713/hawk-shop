    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
