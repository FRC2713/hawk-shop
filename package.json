{
  "name": "hawk-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "typecheck": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "generate:onshape-client": "npx @hey-api/openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "test": "node --import ./tests/register-server-only.mjs --import tsx --test tests/*.test.ts",
    "check:migrations": "node --import tsx --test tests/migrations.test.ts",
    "check:docs": "node --import tsx --test tests/docs-paths.test.ts",
    "test:runtime": "HAWK_SHOP_VERIFY_BUILT_SERVER=1 node --import ./tests/register-server-only.mjs --import tsx --test tests/slack-runtime.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^6.0.2",
    "@dnd-kit/core": "^6.3.1",
