{
  "name": "hawk-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "typecheck": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "generate:onshape-client": "npx @hey-api/openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "test": "node --import ./tests/register-server-only.mjs --import tsx --test tests/*.test.ts",
    "check:migrations": "node --import tsx --test tests/migrations.test.ts",
    "check:docs": "node --import tsx --test tests/docs-paths.test.ts",
    "test:runtime": "HAWK_SHOP_VERIFY_BUILT_SERVER=1 node --import ./tests/register-server-only.mjs --import tsx --test tests/slack-runtime.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^6.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@tanstack/react-query": "^5.107.1",
    "astro": "7.4.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
